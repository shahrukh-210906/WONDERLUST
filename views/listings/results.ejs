<div id="stay-results" data-count="<%= listings.length %>">    <% if (!listings.length) { %><div class="empty-state"><i class="bi bi-compass" aria-hidden="true"></i><h2>A different direction?</h2><p>No stays match these filters. Try another destination or explore all stays.</p><a class="btn btn-primary" href="/listings">Explore all stays</a></div><% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">

      <% listings.forEach(listing => { %>

        <div class="col">

          <div class="card-container">

            <a href="/listings/<%= listing._id %>" class="card-link" aria-label="View <%= listing.title %>"></a>

            <img loading="lazy" src="<%= listing.image?.url || '/images/listing-placeholder.svg' %>" alt="<%= listing.title %>">

            <% if (currUser) { %>

                <% const isWishlisted = currUser.wishlist && currUser.wishlist.some(item => item._id.equals(listing._id)); %>

                <button type="button" class="wishlist-btn" data-listing-id="<%= listing._id %>" aria-label="Save <%= listing.title %>" aria-pressed="<%= isWishlisted %>">

                    <i aria-hidden="true" class="fa-heart <%= isWishlisted ? 'fa-solid' : 'fa-regular' %>"></i>

                </button>

            <% } else { %>

<a href="/login" class="wishlist-btn" aria-label="Log in to save <%= listing.title %>"><i class="fa-regular fa-heart" aria-hidden="true"></i></a>

            <% } %>

            <div class="card-info">

              <p><b><%= listing.title %></b></p>

              <p>₹<%= listing.price ? listing.price.toLocaleString('en-IN') + ' / night' : 'Price not available' %></p>

              <p class="card-location">

                <i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %>

              </p>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </div>
